// Copy to Secrets.xcconfig (gitignored) and fill in.
// In xcconfig, "//" starts a comment, so write URLs as https:/$()/host.
DEVELOPMENT_TEAM = ABCDE12345
SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
// The public "anon" key (NOT the service-role key - that stays on the ESP32).
SUPABASE_ANON_KEY = eyJ...
// Home coordinates (kept out of the repo on purpose).
HOME_LAT = 0.0
HOME_LNG = 0.0
